<?xml version="1.0" encoding="UTF-8"?>
<root width="176" height="180" centered="int">
    <img id="background" src="solarflux:textures/gui/solar.png"
         u-coord="0" v-coord="0"
         image-width="176" image-height="180"
         file-width="176" file-height="180"
    >
        <label value='(q) => q.gui.name' x="8" y="6" color="#404040" shadow="false"/>

        <empty scale="0.9" x="8" y="16">
            <label value='(q) => ({translate: "info.solarflux.energy.stored1", with: [q.gui.energy]})' color="#404040"
                   shadow="false"/>
            <label y="10" value='(q) => ({translate: "info.solarflux.energy.capacity", with: [q.gui.capacity]})'
                   color="#404040" shadow="false"/>
            <label y="20"
                   value='(q) => ({translate: "info.solarflux.energy.generation", with: [q.gui.currentGeneration]})'
                   color="#404040" shadow="false"/>
            <label y="30"
                   value='(q) => ({translate: "info.solarflux.energy.efficiency", with: [q.gui.generation > 0 ? Math.round(100 * q.gui.currentGeneration / q.gui.generation) : 0]})'
                   color="#404040" shadow="false"/>
        </empty>

        <empty id="bars" x="128" y="40">
            <img id="sun_bar_bg" x="1" y="1" image-width="16" image-height="48" u-coord="48" v-coord="64"
                 src="solarflux:textures/gui/elements.png">
                <img id="sun_bar_bg" x="-1" y="-1" image-width="18" image-height="50" u-coord="64" v-coord="62"
                     src="solarflux:textures/gui/elements.png">
                    <img id="sun_bar" x="1" y="(q) => 1 + 48 * (1 - q.gui.sunIntensity)" image-width="16"
                         image-height="(q) => 48 * q.gui.sunIntensity" u-coord="32"
                         v-coord="(q) => 64 + 48 * (1 - q.gui.sunIntensity)"
                         src="solarflux:textures/gui/elements.png"/>

                    <hover width="18" height="50">
                        <tooltip
                                text='(q) => [{translate:"info.solarflux.sun.intensity",with:[Math.round(100 * q.gui.sunIntensity)]}]'/>
                    </hover>
                </img>
            </img>

            <img id="energy_bar_bg" x="23" y="1" image-width="16" image-height="48" u-coord="16" v-coord="64"
                 src="solarflux:textures/gui/elements.png">
                <img id="energy_bar_bg" x="-1" y="-1" image-width="18" image-height="50" u-coord="64" v-coord="62"
                     src="solarflux:textures/gui/elements.png">
                    <img id="energy_bar" x="1" y="(q) => 1 + 48 * (1 - q.gui.energyFill)" image-width="16"
                         image-height="(q) => 48 * q.gui.energyFill" u-coord="0"
                         v-coord="(q) => 64 + 48 * (1 - q.gui.energyFill)"
                         src="solarflux:textures/gui/elements.png"/>

                    <hover width="18" height="50">
                        <tooltip
                                text='(q) => [{translate:"info.solarflux.energy.stored2",with:[q.gui.energy, q.gui.capacity]}]'/>
                    </hover>
                </img>
            </img>
        </empty>

        <label value='(q) => q.gui.inventoryName' x="8" y="86" color="#404040" shadow="false"/>

        <img x="150" y="8" image-width="18" image-height="18" u-coord="18" v-coord="18"
             src="solarflux:textures/gui/elements.png">
            <slot x="1" y="1" index="(q) => q.slots.guiSlots[0]"/>
        </img>

        <empty id="upgrade_slots" x="8" y="60" width="90" height="18">
            <img x="0" y="0" image-width="18" image-height="18" u-coord="18" v-coord="0"
                 src="solarflux:textures/gui/elements.png">
                <slot x="1" y="1" index="(q) => q.slots.guiSlots[1]"/>
            </img>
            <img x="18" y="0" image-width="18" image-height="18" u-coord="18" v-coord="0"
                 src="solarflux:textures/gui/elements.png">
                <slot x="1" y="1" index="(q) => q.slots.guiSlots[2]"/>
            </img>
            <img x="36" y="0" image-width="18" image-height="18" u-coord="18" v-coord="0"
                 src="solarflux:textures/gui/elements.png">
                <slot x="1" y="1" index="(q) => q.slots.guiSlots[3]"/>
            </img>
            <img x="54" y="0" image-width="18" image-height="18" u-coord="18" v-coord="0"
                 src="solarflux:textures/gui/elements.png">
                <slot x="1" y="1" index="(q) => q.slots.guiSlots[4]"/>
            </img>
            <img x="72" y="0" image-width="18" image-height="18" u-coord="18" v-coord="0"
                 src="solarflux:textures/gui/elements.png">
                <slot x="1" y="1" index="(q) => q.slots.guiSlots[5]"/>
            </img>
        </empty>

        <import from="c:player_hotbar" x="7" y="25" align-y="bottom"/>
        <import from="c:player_inventory" x="7" y="83" align-y="bottom"/>
    </img>
</root>